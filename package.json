{
  "name": "bastet-ui",
  "version": "0.1.0",
  "description": "Bastet UI — A themed React component library powered by Ant Design tokens",
  "type": "module",
  "main": "./dist/bastet-ui.cjs.js",
  "module": "./dist/bastet-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bastet-ui.es.js",
      "require": "./dist/bastet-ui.cjs.js"
    },
    "./styles": "./dist/bastet-ui.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "antd": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "antd": "^6.5.4",
    "react": "18",
    "react-dom": "18",
    "storybook": "^10.5.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
